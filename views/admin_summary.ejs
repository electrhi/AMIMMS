<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin</title><link rel="stylesheet" href="/public/app.css"></head><body><main class="shell"><section class="card"><div class="section-head"><div><p class="muted">Admin</p><h1 class="title">종합관리표</h1></div><a class="btn btn-gray" href="/menu">메뉴</a></div><div id="table" class="table-wrap"><div class="card muted">데이터를 불러오는 중입니다.</div></div></section></main><script>async function load(){const el=document.getElementById('table');const r=await fetch('/api/admin_data');const j=await r.json();const data=j.data||[];if(!data.length){el.innerHTML='<div class="card muted">데이터가 없습니다.</div>';return}const combos=[...new Set(data.map(x=>(x['통신방식']||'')+'|'+(x['구분']||'')))].sort();const users=[...new Set(data.map(x=>x['받는사람']||''))].sort();const pivot={};combos.forEach(c=>pivot[c]={});data.forEach(x=>{const k=(x['통신방식']||'')+'|'+(x['구분']||'');const u=x['받는사람']||'';pivot[k][u]=(pivot[k][u]||0)+(Number(x['수량'])||0)});let html='<table><thead><tr><th>통신방식</th><th>구분</th><th>합계</th>';users.forEach(u=>html+='<th>'+u+'</th>');html+='</tr></thead><tbody>';combos.forEach(c=>{const p=c.split('|');let total=users.reduce((s,u)=>s+(pivot[c][u]||0),0);html+='<tr><td>'+p[0]+'</td><td>'+p[1]+'</td><td><b>'+total+'</b></td>';users.forEach(u=>html+='<td>'+(pivot[c][u]||'')+'</td>');html+='</tr>'});html+='</tbody></table>';el.innerHTML=html}load()</script></body></html>