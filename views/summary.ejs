<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Summary</title><link rel="stylesheet" href="/public/app.css"></head><body><main class="shell"><section class="card"><div class="section-head"><div><p class="muted">Summary</p><h1 class="title">누적 자재 현황</h1></div><a class="btn btn-gray" href="/menu">메뉴</a></div><% if (summaryData && summaryData.length) { %><div class="table-wrap"><table><thead><tr><th>통신방식</th><th>구분</th><th>총 수량</th><th>박스 수</th></tr></thead><tbody><% summaryData.forEach(function(x){ %><tr><td><%= x['통신방식'] %></td><td><%= x['구분'] %></td><td><b><%= x['합계'] %></b></td><td><%= x['박스수'] %></td></tr><% }) %></tbody></table></div><% } else { %><div class="card muted"><%= message || '등록된 자재 데이터가 없습니다.' %></div><% } %></section></main></body></html>