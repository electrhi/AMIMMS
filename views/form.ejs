<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Form</title><link rel="stylesheet" href="/public/app.css"></head><body><main class="shell"><section class="card"><div class="section-head"><div><p class="muted">Receipt</p><h1 class="title">자재 인수증 작성</h1></div><a class="btn btn-gray" href="/menu">메뉴</a></div><form method="post" id="materialForm"><div class="table-wrap"><table><thead><tr><th>통신방식</th><th>구분</th><th>신철</th><th>수량</th><th>박스번호</th><th>삭제</th></tr></thead><tbody id="rows"><% const list = materials && materials.length ? materials : [{}]; %><% list.forEach(function(m){ %><tr><td><select class="select comm" name="통신방식"><option><%= m['통신방식'] || '' %></option><option>KS-PLC</option><option>HPGP</option><option>IoT-PLC</option><option>LTE</option><option>부속자재</option></select></td><td><select class="select cat" name="구분"><option><%= m['구분'] || '' %></option></select></td><td><select class="select" name="신철"><option><%= m['신철'] || '신' %></option><option>신</option><option>철</option></select></td><td><input class="input qty" name="수량" type="number" value="<%= m['수량'] || '' %>"></td><td><input class="input box" name="박스번호" value="<%= m['박스번호'] || '' %>"></td><td><button class="btn btn-danger del" type="button">삭제</button></td></tr><% }) %></tbody></table></div><div class="card"><h2>합계 요약</h2><div id="summary" class="muted">입력값 기준으로 자동 계산됩니다.</div></div><div class="actions"><button class="btn btn-green" type="button" id="add">행 추가</button><button class="btn btn-primary" type="submit">다음</button></div></form></section></main><script src="/public/form.js"></script></body></html>