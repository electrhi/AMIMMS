<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Confirm</title><link rel="stylesheet" href="/public/app.css"></head><body><main class="shell"><section class="card"><h1 class="title">자재 인수증 확인</h1><div class="table-wrap"><table><thead><tr><th>통신방식</th><th>구분</th><th>신철</th><th>수량</th><th>박스번호</th></tr></thead><tbody><% materials.forEach(function(m){ %><tr><td><%= m['통신방식'] %></td><td><%= m['구분'] %></td><td><%= m['신철'] %></td><td><%= m['수량'] %></td><td><%= m['박스번호'] %></td></tr><% }) %></tbody></table></div><form method="post" onsubmit="return saveSigns()"><div class="field"><label class="label">주는 사람</label><input class="input" name="giver" required></div><div class="field"><label class="label">주는 사람 서명</label><canvas class="signature-pad" id="giverCanvas"></canvas><button class="btn btn-gray" type="button" onclick="clearCanvas('giverCanvas')">지우기</button></div><div class="field"><label class="label">받는 사람</label><input class="input" name="receiver" value="<%= loggedUser %>" readonly></div><div class="field"><label class="label">받는 사람 서명</label><canvas class="signature-pad" id="receiverCanvas"></canvas><button class="btn btn-gray" type="button" onclick="clearCanvas('receiverCanvas')">지우기</button></div><input name="giver_sign" id="giver_sign" type="hidden"><input name="receiver_sign" id="receiver_sign" type="hidden"><div class="actions"><a class="btn btn-gray" href="/form">이전</a><button class="btn btn-primary" type="submit">생성</button></div></form></section></main><script src="/public/sign.js"></script></body></html>